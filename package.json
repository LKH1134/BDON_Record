{
  "name": "bdon-record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BDON local account and rhythm game record prototype",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "sync-data": "python scripts/import_data.py",
    "migrate:song-ids": "node scripts/migrate-song-ids.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "dev:worker": "npm run build:worker && wrangler dev --local",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check:worker": "npm run build:worker && wrangler deploy --dry-run --outdir .local/worker-build",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "miniflare": "5.20261019.2-beta",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5"
  }
}
